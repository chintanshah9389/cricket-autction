# Copy to .env and fill with your Railway Postgres + Cloudflare R2 values.
# Local SaaS: npm run saas:migrate && npm run saas:seed-superadmin && npm run saas

PORT=3000
NODE_ENV=development

# Railway Postgres (use the public connection URL for local; private URL on Railway)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/railway

# JWT — use a long random string in production
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# First Super Admin (seed script)
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_MOBILE=
SUPERADMIN_PASSWORD=ChangeMeNow!
SUPERADMIN_NAME=Super Admin

# Object storage: Cloudflare R2 via Worker (preferred) OR S3-compatible keys
# Worker mode (no S3 Access Key needed) — deployed as cricket-auction-media
R2_WORKER_URL=https://cricket-auction-media.YOUR_SUBDOMAIN.workers.dev
R2_WORKER_SECRET=generate_a_long_random_secret
# S3-compatible fallback (Railway Bucket or R2 API tokens):
R2_ENDPOINT=
R2_ACCOUNT_ID=efb8012adbc7afcbb03fdcfd5bade02c
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET=cricket-auction-media
R2_PUBLIC_BASE_URL=https://pub-YOUR_BUCKET_ID.r2.dev
R2_REGION=auto
